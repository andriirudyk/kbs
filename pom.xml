<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.optimagrowth</groupId>
  <version>0.0.1-SNAPSHOT</version>
  <artifactId>kbra-parent-pom</artifactId>
  <packaging>pom</packaging>


  <name>kbra-parent-pom</name>
  <description>Parent Pom for the KitchenBarServices project</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.2.3.RELEASE</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <properties>
	 <docker.image.prefix>kbra</docker.image.prefix>
	</properties>

  <modules>
    <module>configserver</module>
    <module>eurekaserver</module>
    <module>gatewayserver</module>
    <module>catalog</module>
    <module>ordering</module>
    <module>inventory</module>
    <module>kitchenbar</module>
    <module>billing</module>
  </modules>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>