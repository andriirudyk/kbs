{
  "realm": "development",
  "displayName": "Development Realm",
  "enabled": true,

  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,

  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Regular application user"
      },
      {
        "name": "ADMIN",
        "description": "Application administrator"
      }
    ]
  },

  "clients": [
    {
      "clientId": "angular-client",
      "name": "Angular application",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,

      "redirectUris": [
        "http://localhost:4200/*"
      ],

      "webOrigins": [
        "http://localhost:4200"
      ],

      "attributes": {
        "post.logout.redirect.uris": "http://localhost:4200/*",
        "pkce.code.challenge.method": "S256"
      },

      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    },

    {
      "clientId": "spring-client",
      "name": "Spring Boot application",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "secret": "${SPRING_CLIENT_SECRET}",

      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,

      "redirectUris": [
        "http://localhost:8081/*"
      ],

      "webOrigins": [
        "http://localhost:4200"
      ],

      "defaultClientScopes": [
        "roles",
        "profile",
        "email"
      ]
    }
  ],

  "users": [
    {
      "username": "student",
      "enabled": true,
      "emailVerified": true,

      "firstName": "Test",
      "lastName": "Student",
      "email": "student@example.com",

      "credentials": [
        {
          "type": "password",
          "value": "student123",
          "temporary": false
        }
      ],

      "realmRoles": [
        "USER"
      ]
    }
  ]
}